# ==============================================================================
# KaziBox Platform Environment Variables Example
# Copy to .env.local for local development. Never commit sensitive keys to git.
# ==============================================================================

# --- KaziBox Core Supabase Database & Auth (Project: vkixehivjytpuhrjlaud) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- KaziBox Internal Security Tokens ---
KAZIBOX_SSO_SECRET=your-kazi-sso-secret
KAZIBOX_WEBHOOK_SECRET=your-kazi-webhook-secret

# --- Centralized Moteur Payment Infrastructure (DPaaS) ---
# Direct Supabase edge gateway or custom domain:
# Option A (Supabase Edge Function Gateway): https://lvfoklqxqwgpktylphbu.supabase.co/functions/v1/engine-api-gateway
# Option B (Custom domain proxy): https://moteur.kazibox.pro
MOTEUR_API_BASE_URL=https://lvfoklqxqwgpktylphbu.supabase.co/functions/v1/engine-api-gateway
MOTEUR_ENVIRONMENT=sandbox
MOTEUR_APP_CODE=demosaas

# Server-side Moteur credentials (Required for live payment processing)
# Must be obtained from Moteur admin / client
MOTEUR_API_KEY=your_sandbox_x_engine_api_key_here
MOTEUR_GATEWAY_BEARER_TOKEN=your_sandbox_gateway_bearer_token_here
MOTEUR_WEBHOOK_SECRET=your_sandbox_webhook_secret_here
